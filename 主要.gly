{
  "version": 1,
  "name": "主要.gly",
  "entries": [
    {
      "id": "6de63672-e416-4984-938b-2f0cbd36a4da",
      "term": "空间转换",
      "definition": "吴谓获得的核心能力。能够将异常机器或事物看作拟人化形态，并与之直接“交流”，甚至对其进行“修复”。代价：使用此能力“修复”异常后，会改变该区域的磁场造成影响。导致异常事件的影响被抹除，所有人（包括吴谓自己）都会忘记该异常曾存在过。",
      "category": "技能",
      "aliases": [
        "异常交流",
        "异常修复",
        "spaceConvert"
      ]
    },
    {
      "id": "2eb93563-9f50-42ea-ac5e-24e139b1646d",
      "term": "心芯相传",
      "definition": "吴谓获得的能力之一。能够隔空传输文件与数据。在遭遇异常档案（如呈现为▮的损坏数据）时，吴谓可以通过此技能进行剥离、转移或传递，是推动剧情解密的关键能力。",
      "category": "技能",
      "aliases": [
        "隔空传文件",
        "推动作用",
        "chill2chip"
      ]
    },
    {
      "id": "b8a323ff-195c-42df-a4df-079ae709a1fe",
      "term": "异常档案",
      "definition": "FX-7散落后对事物造成的异常现象，及其对应的原始说明书或记录资料。这些资料常处于损坏（▮）或被抹除（[数据删除]）的状态，是吴谓和杜淼拼凑真相的核心线索。",
      "category": "概念",
      "aliases": [
        "档案碎片",
        "异常说明书"
      ]
    },
    {
      "id": "dab88384-544b-4d62-8912-138e4825b089",
      "term": "▮（损坏数据）、[数据删除]或[/已编辑]",
      "definition": "吴谓转移不完整数据档案的能力体现。纯黑实心方块，代表不完整的异常档案。当吴谓成功将其转移到自己设备上后，▮会碎裂并显示完整的原始数据。人为删除的数据则显示为[数据删除]。",
      "category": "概念",
      "aliases": [
        "损坏符号",
        "黑块"
      ]
    },
    {
      "id": "7bb6ac5d-a048-4fe3-beda-6e67cd3d6e4b",
      "term": "FX-8pre（预迭代主控系统）",
      "definition": "“全球天眼（Fax Xenon）”正在推行的第二代中心主控系统（预发布版）。",
      "category": "FX项目",
      "aliases": [
        "轭湾（Enker）",
        "天眼升级版"
      ]
    },
    {
      "id": "d856248d-0c75-4008-962d-0704d75e5532",
      "term": "FX-7（旧型号主控设备）",
      "definition": "“全球天眼（Fax Xenon）”第一代中心区域主控设备。向前版本为分散区域，多主控。对外伪装成概率稳定装置。核心为碳基-硅基嵌合体，能转移因果意外。在科技展发生故障，导致吴谓获得能力，且其残留逻辑死锁了中心区域，导致全球网络瘫痪。",
      "category": "FX项目",
      "aliases": [
        "怪猫（Cassy）",
        "概率稳定装置",
        "KX-7",
        "P01"
      ]
    },
    {
      "id": "47280796-fb96-4f04-9b9b-2ccf081a2424",
      "term": "FX系列（Fax Xenon）",
      "definition": "边缘科技（Edge Tech）集团的核心网络基础设施项目。",
      "category": "FX项目",
      "aliases": [
        "传氙",
        "全球天眼"
      ]
    },
    {
      "id": "077bed87-f04f-4335-92a9-cdcb0cd4c9a1",
      "term": "边缘科技集团（Edge Tech）",
      "definition": "全球顶级的底层网络基础设施与数据管理巨头。致力于构建覆盖全球的数据协调网络，即“全球天眼”计划。",
      "category": "组织",
      "aliases": [
        "Edge Tech",
        "FX公司"
      ]
    },
    {
      "id": "cae09254-6bc6-460f-bf70-5743dc4ccb3d",
      "term": "秉帆网络科技有限责任公司（Puff Net）",
      "definition": "一家处于快速上升期的中型网络技术企业。主营高并发网络架构与底层数据传输协议研发。技术部员工吴谓任底层架构组组长。",
      "category": "组织",
      "aliases": [
        "秉帆科技",
        "Puff Net",
        "吴谓公司"
      ]
    },
    {
      "id": "29911b34-96ab-479c-bec8-d9b53508ffc6",
      "term": "吴谓同事",
      "definition": "秉帆网络科技技术部员工（项目经理）。性格圆滑世故，负责向吴谓传达领导安排，提醒他在展会多认识边缘科技的人。外观锚点：圆脸、爱笑、左耳戴银耳钉、浅蓝衬衫、工牌挂脖。",
      "category": "人物",
      "aliases": [
        "秉帆同事",
        "C04"
      ]
    },
    {
      "id": "24736be6-bf4d-4f33-9fd2-19369690be6f",
      "term": "FX-7公司负责人",
      "definition": "边缘科技(edge tech)集团，FX（fax xenon,传氙，又名：全球天眼）系列项目负责人。项目由国际组织完全控制。深知FX-8pre迁移失败的风险，为了掩盖全球网络瘫痪丑闻，冷酷决定将FX-7硬展，并下令监控靠近设备的人。外观锚点：灰鬓、眼袋深重、深灰西装卷袖、左手无名指戴旧银戒。",
      "category": "人物",
      "aliases": [
        "大卫？",
        "C03"
      ]
    },
    {
      "id": "fcc280fc-4672-4ac2-a595-aaa387443d3c",
      "term": "杜淼",
      "definition": "丽杉初中学生，爱好科技与计算机网络。借旧证混入科技展追查全球天眼漏洞。拥有极端记录习惯，常遇[数据删除]屏蔽。作为吴谓的记忆锚点，他的记录是唯一对抗遗忘的证据。外观锚点：圆脸、一撮翘起短发、双肩包侧袋插笔、平板贴满标签。",
      "category": "人物",
      "aliases": [
        "独苗",
        "副主角",
        "C02"
      ]
    },
    {
      "id": "69c54fa6-9036-4a60-9309-0146240fe156",
      "term": "吴谓",
      "definition": "秉帆网络科技（puff net）有限责任公司，技术部底层架构组组长。在科技展FX-7故障中获得双能力：“心芯相传”（隔空传文件）与“空间转换”（与异常交流并修复）。外观锚点：细框眼镜、短寸头、深灰连帽风衣。",
      "category": "人物",
      "aliases": [
        "无所谓",
        "主角",
        "C01"
      ]
    }
  ]
}
